{
  "name": "foodzinder-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "test": "vitest run",
    "test:watch": "vitest",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@clerk/localizations": "^4.16.0",
    "@clerk/nextjs": "^6",
    "@hookform/resolvers": "^5",
    "@prisma/client": "^6",
    "@upstash/ratelimit": "^2",
    "@upstash/redis": "^1",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "framer-motion": "^12",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511",
    "meilisearch": "^0.49",
    "next": "16.2.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7",
    "react-leaflet": "^5.0.0",
    "recharts": "^2",
    "resend": "^4",
    "shadcn": "^4.20.1",
    "stripe": "^18",
    "svix": "^1.93.0",
    "tailwind-merge": "^3",
    "tw-animate-css": "^1.4.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@react-email/components": "^0.3",
    "@react-email/render": "^1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6",
    "react-email": "^4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
