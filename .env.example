# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# DATABASE (Neon en producción; Docker en local)
# ============================================
DATABASE_URL=postgresql://foodzinder:foodzinder_dev@localhost:5432/foodzinder
# Cadena sin pooling, la usa Prisma para migraciones (en local puede ser la misma)
DIRECT_URL=postgresql://foodzinder:foodzinder_dev@localhost:5432/foodzinder

# ============================================
# API v1 Y WEBHOOKS SALIENTES (ver docs/api.md)
# ============================================
# Clave para los endpoints privados /api/v1/admin/* (cabecera X-Api-Key). Generar con: openssl rand -hex 32
FOODZINDER_API_KEY=
# Secreto HMAC con el que se firman los webhooks salientes
WEBHOOK_SECRET=
# URLs destino de los webhooks, separadas por comas (vacío = no se envían)
WEBHOOK_URLS=

# ============================================
# REDIS (Upstash for production, local for dev)
# ============================================
UPSTASH_REDIS_REST_URL=http://localhost:6379
UPSTASH_REDIS_REST_TOKEN=

# ============================================
# MEILISEARCH
# ============================================
NEXT_PUBLIC_MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=masterKey123
MEILISEARCH_ADMIN_KEY=

# ============================================
# CLERK
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ============================================
# STRIPE
# ============================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================
# PAYPAL
# ============================================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ============================================
# BUNNY.NET
# ============================================
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_REGION=
BUNNY_PULL_ZONE_URL=

# ============================================
# RESEND (EMAIL)
# ============================================
RESEND_API_KEY=
EMAIL_FROM=noreply@foodzinder.com

# ============================================
# GEOLOCATION
# ============================================
NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org

# ============================================
# ANALYTICS
# ============================================
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=

# ============================================
# CRON
# ============================================
CRON_SECRET=
