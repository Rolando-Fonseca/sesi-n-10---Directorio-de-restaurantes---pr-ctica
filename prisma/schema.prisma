generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  OWNER
  USER
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum PriceRange {
  CHEAP
  MODERATE
  EXPENSIVE
  LUXURY
}

enum TaxonomyScope {
  RESTAURANT
  MENU_PRESENTATION
  MENU_ALLERGEN
  MENU_CATEGORY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum InvoiceStatus {
  PAID
  VOID
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  EXPIRED
  DEPLETED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

enum NotificationType {
  NEW_OWNER_REGISTRATION
  NEW_RESTAURANT_CREATED
  NEW_MENU_CREATED
  RESTAURANT_APPROVED
  RESTAURANT_REJECTED
  SUBSCRIPTION_EXPIRING
  REVIEW_RECEIVED
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id             String   @id // Clerk user ID
  email          String   @unique
  firstName      String?
  lastName       String?
  imageUrl       String?
  role           UserRole @default(USER)
  phone          String?
  taxId          String?
  billingName    String?
  billingAddress String?
  locale         String   @default("es")
  points         Int      @default(0)
  level          Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurants       Restaurant[]
  menus             Menu[]
  reviews           Review[]
  subscriptions     Subscription[]
  invoices          Invoice[]
  couponRedemptions CouponRedemption[]
  wishlistItems     WishlistItem[]
  preferences       UserPreference[]
  userAllergens     UserAllergen[]
  notifications     Notification[]
  pointTransactions PointTransaction[]
  badges            UserBadge[]

  @@index([role])
  @@index([email])
  @@map("users")
}

model UserPreference {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String
  taxonomyId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taxonomy Taxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)

  @@unique([userId, taxonomyId])
  @@index([userId])
  @@map("user_preferences")
}

model UserAllergen {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String
  allergenId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergen Taxonomy @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@unique([userId, allergenId])
  @@index([userId])
  @@map("user_allergens")
}

// ============================================
// TAXONOMIES
// ============================================

model Taxonomy {
  id          String        @id @default(uuid()) @db.Uuid
  scope       TaxonomyScope
  name        String
  slug        String        @unique
  icon        String?
  description String?       @db.Text
  order       Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  restaurants    RestaurantTaxonomy[]
  dishTaxonomies DishTaxonomy[]
  menuCategories MenuCategory[]
  userPreferences UserPreference[]
  userAllergens  UserAllergen[]

  @@unique([scope, slug])
  @@index([scope])
  @@index([scope, isActive])
  @@map("taxonomies")
}

// ============================================
// RESTAURANTS
// ============================================

model Restaurant {
  id              String           @id @default(uuid()) @db.Uuid
  ownerId         String
  name            String
  slug            String           @unique
  description     String?          @db.Text
  address         String
  city            String?
  postalCode      String?
  country         String           @default("ES")
  latitude        Float
  longitude       Float
  phone           String?
  website         String?
  status          RestaurantStatus @default(PENDING)
  rejectionReason String?          @db.Text
  logoUrl         String?
  coverUrl        String?
  priceRange      PriceRange?
  averageRating   Float?           @default(0)
  reviewCount     Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  owner          User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  menus          RestaurantMenu[]
  menuCategories MenuCategory[]
  reviews        Review[]
  taxonomies     RestaurantTaxonomy[]
  wishlistItems  WishlistItem[]

  @@index([ownerId])
  @@index([slug])
  @@index([status])
  @@index([city])
  @@index([priceRange])
  @@index([averageRating])
  @@map("restaurants")
}

model RestaurantTaxonomy {
  restaurantId String @db.Uuid
  taxonomyId   String @db.Uuid

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  taxonomy   Taxonomy   @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)

  @@id([restaurantId, taxonomyId])
  @@index([restaurantId])
  @@index([taxonomyId])
  @@map("restaurant_taxonomies")
}

// ============================================
// MENUS
// ============================================

model Menu {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String
  title       String
  description String?   @db.Text
  price       Decimal?  @db.Decimal(10, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  restaurants RestaurantMenu[]
  dishes      Dish[]

  @@index([ownerId])
  @@index([isActive])
  @@map("menus")
}

model RestaurantMenu {
  restaurantId String   @db.Uuid
  menuId       String   @db.Uuid
  assignedAt   DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menu       Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([restaurantId, menuId])
  @@index([restaurantId])
  @@index([menuId])
  @@map("restaurant_menus")
}

model MenuCategory {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @db.Uuid
  taxonomyId   String?  @db.Uuid
  name         String
  slug         String
  description  String?  @db.Text
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  taxonomy   Taxonomy?  @relation(fields: [taxonomyId], references: [id], onDelete: SetNull)
  dishes     Dish[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([order])
  @@map("menu_categories")
}

// ============================================
// DISHES
// ============================================

model Dish {
  id          String   @id @default(uuid()) @db.Uuid
  menuId      String   @db.Uuid
  categoryId  String?  @db.Uuid
  name        String
  slug        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menu          Menu           @relation(fields: [menuId], references: [id], onDelete: Cascade)
  category      MenuCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taxonomies    DishTaxonomy[]
  wishlistItems WishlistItem[]

  @@unique([menuId, slug])
  @@index([menuId])
  @@index([categoryId])
  @@index([order])
  @@index([isFeatured])
  @@map("dishes")
}

model DishTaxonomy {
  dishId     String @db.Uuid
  taxonomyId String @db.Uuid

  dish     Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  taxonomy Taxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)

  @@id([dishId, taxonomyId])
  @@index([dishId])
  @@index([taxonomyId])
  @@map("dish_taxonomies")
}

// ============================================
// REVIEWS (MULTI-CRITERIA)
// ============================================

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @db.Uuid
  userId       String
  comment      String?  @db.Text
  photos       String[]
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings    ReviewRating[]

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@index([userId])
  @@index([createdAt])
  @@index([isActive])
  @@map("reviews")
}

model ReviewRating {
  id        String @id @default(uuid()) @db.Uuid
  reviewId  String @db.Uuid
  criterion String
  score     Int

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, criterion])
  @@index([reviewId])
  @@index([criterion])
  @@map("review_ratings")
}

// ============================================
// WISHLIST
// ============================================

model WishlistItem {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String
  dishId       String   @db.Uuid
  restaurantId String   @db.Uuid
  notes        String?  @db.Text
  quantity     Int      @default(1)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dish       Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, dishId])
  @@index([userId])
  @@index([restaurantId])
  @@map("wishlist_items")
}

// ============================================
// SUBSCRIPTIONS & PAYMENTS
// ============================================

model Plan {
  id                      String   @id @default(uuid()) @db.Uuid
  name                    String
  slug                    String   @unique
  description             String?  @db.Text
  priceMonthly            Decimal  @db.Decimal(10, 2)
  priceAnnual             Decimal  @db.Decimal(10, 2)
  maxRestaurants          Int      @default(1)
  maxMenus                Int      @default(5)
  maxDishesPerMenu        Int      @default(50)
  features                Json
  isActive                Boolean  @default(true)
  stripePriceIdMonthly    String?
  stripePriceIdAnnual     String?
  paypalPlanIdMonthly     String?
  paypalPlanIdAnnual      String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  subscriptions Subscription[]

  @@index([slug])
  @@index([isActive])
  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String
  planId                 String             @db.Uuid
  provider               PaymentProvider
  providerSubscriptionId String?
  startDate              DateTime
  endDate                DateTime
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  amount                 Decimal            @db.Decimal(10, 2)
  currency               String             @default("EUR")
  interval               String             @default("monthly")
  trialEndsAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([userId])
  @@index([status])
  @@index([providerSubscriptionId])
  @@map("subscriptions")
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  subscriptionId   String        @db.Uuid
  userId           String
  number           String        @unique
  amountSubtotal   Decimal       @db.Decimal(10, 2)
  taxAmount        Decimal       @db.Decimal(10, 2)
  taxRate          Decimal       @db.Decimal(5, 2)
  total            Decimal       @db.Decimal(10, 2)
  status           InvoiceStatus @default(PAID)
  provider         PaymentProvider
  providerInvoiceId String?
  issuedAt         DateTime      @default(now())
  pdfUrl           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([userId])
  @@index([number])
  @@index([issuedAt])
  @@map("invoices")
}

// ============================================
// COUPONS
// ============================================

model Coupon {
  id               String       @id @default(uuid()) @db.Uuid
  code             String       @unique
  type             CouponType
  value            Decimal      @db.Decimal(10, 2)
  description      String?      @db.Text
  maxUses          Int?
  usedCount        Int          @default(0)
  maxUsesPerUser   Int          @default(1)
  minPurchase      Decimal?     @db.Decimal(10, 2)
  validFrom        DateTime     @default(now())
  validUntil       DateTime?
  applicablePlanIds String[]
  status           CouponStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  redemptions CouponRedemption[]

  @@index([code])
  @@index([status])
  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @db.Uuid
  userId         String
  subscriptionId String?  @db.Uuid
  discountAmount Decimal  @db.Decimal(10, 2)
  redeemedAt     DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@map("coupon_redemptions")
}

// ============================================
// GAMIFICATION
// ============================================

model PointTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String
  points      Int
  reason      String
  referenceId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reason])
  @@index([createdAt])
  @@map("point_transactions")
}

model Badge {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String   @db.Text
  iconUrl     String?
  threshold   Int
  category    String
  createdAt   DateTime @default(now())

  userBadges UserBadge[]

  @@index([category])
  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String
  badgeId  String   @db.Uuid
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String?
  type        NotificationType
  title       String
  message     String           @db.Text
  referenceId String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}
